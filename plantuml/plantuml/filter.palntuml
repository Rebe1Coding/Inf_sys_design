@startuml sequence_filter
!theme plain
autonumber

title Диаграмма последовательности: Фильтрация клиентов (п.6)

actor Пользователь as User
participant "HTML/JS\n(View)" as View
participant "FastAPI\n(App)" as FastAPI
participant "MainController\n(Controller)" as Controller
participant "FilteredClientDB\nRepository\n(ДЕКОРАТОР)" as Decorator
participant "Client_rep_DB\n(Model)" as DB
database "PostgreSQL" as Database

User -> View: Выбирает тип собственности\nв фильтре: "ООО"
activate View

View -> View: Обработчик change\nна select#ownershipFilter

View -> View: currentFilter = "ООО"\ncurrentPage = 1

View -> View: loadClients()

View -> FastAPI: GET /api/clients\n?page=1&page_size=10\n&ownership_filter=ООО
activate FastAPI

FastAPI -> Controller: get_clients_page(\npage=1,\npage_size=10,\nownership_filter="ООО",\nsort_field=None)
activate Controller

note right of Controller
  Контроллер применяет
  ПАТТЕРН ДЕКОРАТОР
  для фильтрации
end note

Controller -> Decorator: new FilteredClientDBRepository(\ndb_repo,\nfilter_sql="ownership_type = 'ООО'",\norder_by="client_id")
activate Decorator

note right of Decorator
  ПАТТЕРН ДЕКОРАТОР:
  Добавляет фильтрацию
  к существующему репозиторию
end note

Controller -> Decorator: get_k_n_short_list(10, 1)

Decorator -> DB: execute SQL с фильтром
activate DB

DB -> Database: SELECT name, contact_person\nFROM clients\nWHERE ownership_type = 'ООО'\nORDER BY client_id\nLIMIT 10 OFFSET 0
activate Database
Database --> DB: filtered_rows[]
deactivate Database

DB --> Decorator: short_list[]
deactivate DB

Decorator --> Controller: filtered_list[]
deactivate Decorator

Controller -> Decorator: get_count()
activate Decorator

Decorator -> DB: execute COUNT с фильтром
activate DB

DB -> Database: SELECT COUNT(*)\nFROM clients\nWHERE ownership_type = 'ООО'
activate Database
Database --> DB: filtered_count
deactivate Database

DB --> Decorator: filtered_count
deactivate DB

Decorator --> Controller: filtered_count
deactivate Decorator

Controller --> FastAPI: {\n  "clients": [...только ООО...],\n  "current_page": 1,\n  "total_pages": 2,\n  "total_count": 15\n}
deactivate Controller

FastAPI --> View: JSON Response
deactivate FastAPI

View -> View: renderClientsTable(\nfiltered_clients)

View -> View: renderPagination(\ncurrent_page,\ntotal_pages)

View --> User: Показывает только\nклиентов типа "ООО"
deactivate View

note over User, Database
  ПАТТЕРН ДЕКОРАТОР:
  - FilteredClientDBRepository оборачивает Client_rep_DB
  - Добавляет WHERE условие в SQL запросы
  - Не изменяет базовый репозиторий
  - Можно комбинировать с сортировкой
end note

== Сброс фильтра ==

User -> View: Выбирает "Все"\nв фильтре
activate View

View -> View: currentFilter = ""\ncurrentPage = 1

View -> View: loadClients()

View -> FastAPI: GET /api/clients\n?page=1&page_size=10\n&ownership_filter=
activate FastAPI

FastAPI -> Controller: get_clients_page(\npage=1,\npage_size=10,\nownership_filter="",\nsort_field=None)
activate Controller

note right of Controller
  Без фильтра -
  используем обычный
  репозиторий
end note

Controller -> DB: get_k_n_short_list(10, 1)
activate DB

DB -> Database: SELECT name, contact_person\nFROM clients\nORDER BY client_id\nLIMIT 10 OFFSET 0
activate Database
Database --> DB: all_rows[]
deactivate Database

DB --> Controller: all_clients_list[]
deactivate DB

Controller -> DB: get_count()
activate DB
DB -> Database: SELECT COUNT(*)\nFROM clients
activate Database
Database --> DB: total_count
deactivate Database
DB --> Controller: total_count
deactivate DB

Controller --> FastAPI: {\n  "clients": [...все клиенты...],\n  "current_page": 1,\n  "total_pages": 3,\n  "total_count": 25\n}
deactivate Controller

FastAPI --> View: JSON Response
deactivate FastAPI

View -> View: renderClientsTable(\nall_clients)

View --> User: Показывает всех клиентов
deactivate View

@enduml